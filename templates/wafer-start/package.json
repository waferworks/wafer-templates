{
  "name": "wafer-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "_dev:app": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "bun run ./scripts/start.ts",
    "start": "bun run ./scripts/start.ts",
    "_start:app": "node .output/server/index.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "smoke": "bun run ./scripts/smoke.ts",
    "smoke:db": "bun run ./scripts/smoke-db.ts",
    "check": "bun run lint && bun run build && bun run test && bun run smoke",
    "check:db": "bun run smoke:db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./scripts/db-migrate.ts",
    "db:push": "bun run ./scripts/db-push.ts",
    "_db:push:app": "drizzle-kit push"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.1.3",
    "@hookform/resolvers": "^5.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-start": "^1.167.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.57.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.2.15",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.4",
    "nitro": "^3.0.260311-beta",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
