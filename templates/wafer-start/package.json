{
  "name": "wafer-start",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "_dev:app": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "bun run ./scripts/start.ts",
    "start": "bun run ./scripts/start.ts",
    "_start:app": "node .output/server/index.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "smoke": "bun run ./scripts/smoke.ts",
    "smoke:db": "bun run ./scripts/smoke-db.ts",
    "check": "bun run lint && bun run build && bun run test && bun run smoke",
    "check:db": "bun run smoke:db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run ./scripts/db-migrate.ts",
    "db:push": "bun run ./scripts/db-push.ts",
    "_db:push:app": "drizzle-kit push"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.2.7",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-start": "^1.168.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "nitro": "^3.0.260311-beta",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "esbuild": "0.27.7",
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.2",
    "hono": "4.12.21",
    "ip-address": "10.2.0",
    "js-cookie": "3.0.7",
    "qs": "6.15.2"
  }
}
