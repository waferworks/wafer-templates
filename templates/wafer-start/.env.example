# Wafer provides these at runtime:
# HOST=
# PORT=

# Optional Clerk auth.
# Set both values together. Leaving either one blank keeps auth disabled.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app

# Database - pick one mode. Leave both modes commented to run without DB.
#
# Hosted/external:
# DATABASE_URL=

# Wafer per-project Postgres:
# wafer-project init writes these with a real DATABASE_NAME.
# PG_BOOTSTRAP_URL=postgresql://postgres@localhost/postgres
# DATABASE_NAME=
