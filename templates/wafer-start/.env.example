# Optional Clerk auth
# Set both values together. Leaving either one blank keeps auth disabled.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app

# Direct hosted-database mode
DATABASE_URL=

# Wafer bootstrap mode
# Set both values together. Leaving either one blank disables bootstrap mode.
PG_BOOTSTRAP_URL=postgresql://postgres@localhost/wafer
DATABASE_NAME=wafer_start
